DJANGO_DEBUG=True
# Generate a fresh random key using the README instructions.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Leave unset for SQLite. Optional: postgresql://user:password@localhost:5432/smart_delivery
# DATABASE_URL=
OSRM_BASE_URL=https://router.project-osrm.org
# Optional self-hosted or contracted Nominatim-compatible endpoint, without /search.
# The public nominatim.openstreetmap.org service is deliberately not enabled.
GEOCODER_BASE_URL=
PROVIDER_USER_AGENT=SmartDeliveryRoutePlanner/1.0 (local demo)
PROVIDER_TIMEOUT=10
PROVIDER_MIN_INTERVAL=1.1
# Optional tile service override; keep its required attribution.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=
